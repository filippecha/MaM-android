diff --git a/src/Engine/Resources/ResourceManager.cpp b/src/Engine/Resources/ResourceManager.cpp
index ea97cf8..8379cfe 100644
--- a/src/Engine/Resources/ResourceManager.cpp
+++ b/src/Engine/Resources/ResourceManager.cpp
@@ -3,6 +3,8 @@
 #include "Library/LodFormats/LodFormats.h"
 #include "Library/FileSystem/Interface/FileSystem.h"
 
+#include "Utility/String/Ascii.h"
+
 #include "EngineFileSystem.h"
 
 ResourceManager::ResourceManager() = default;
@@ -17,5 +19,11 @@ void ResourceManager::open() {
 }
 
 Blob ResourceManager::eventsData(std::string_view filename) {
-    return lod::decodeMaybeCompressed(_eventsLodReader.read(filename));
+    Blob result = lod::decodeMaybeCompressed(_eventsLodReader.read(filename));
+
+    bool isText = filename.size() >= 4 && ascii::noCaseEquals(filename.substr(filename.size() - 4), ".txt");
+    if (isText && result.size() > 0 && result.str().back() == '\x1a')
+        return result.subBlob(0, result.size() - 1); // Some localized tables end with a DOS EOF marker.
+
+    return result;
 }
diff --git a/src/Library/LodFormats/LodFormats.cpp b/src/Library/LodFormats/LodFormats.cpp
index 930266e..cf1a954 100644
--- a/src/Library/LodFormats/LodFormats.cpp
+++ b/src/Library/LodFormats/LodFormats.cpp
@@ -80,7 +80,7 @@ bool lod::detectImage(const Blob &blob, bool *isPalette) {
         return isPalette ? *isPalette = true : true;
 
     if (header.size > 0 && header.dataSize > 0 && header.width > 0 && header.height > 0 &&
-        header.size == header.width * header.height &&
+        header.size >= header.width * header.height && // Some localization tools write the source BMP file size here.
         (header.decompressedSize == 0 && header.dataSize >= header.size || header.decompressedSize > 0 && header.decompressedSize >= header.size) &&
         blob.size() == sizeof(LodImageHeader_MM6) + header.dataSize + 0x300)
         return true;
